# Kopiera dessa till Railway -> din service -> Variables. Lägg ALDRIG riktiga nycklar i GitHub.

ANTHROPIC_API_KEY=
TWELVEDATA_API_KEY=

# Cookies från ditt SEPARATA X-konto (valfritt – utan dem används bara nyhetsflöden)
X_AUTH_TOKEN=
X_CT0=

# Lösenord för hemsidan (rekommenderas, annars kan alla med länken se den)
DASHBOARD_PASSWORD=

# Spara databasen på Railway-volymen (montera en volym på /data)
DB_PATH=/data/agents.db

# --- Valfritt: regler (standardvärden visas) ---
# ANALYST_MIN_CONF=65
# AVG_MIN_CONF=70
# RISK_MIN_PCT=0.5
# RISK_MAX_PCT=2.0
# SL_ATR_MULT=1.5
# RR=2.0
# START_BALANCE=10000
# CYCLE_MINUTES=5

# --- Valfritt: modeller ---
# MODEL_SCOUT=claude-haiku-5-5
# MODEL_HUNTER=claude-haiku-5-5
# MODEL_ANALYST=claude-sonnet-5-5

# --- Valfritt: symboler hos Twelve Data ---
# GOLD_SYMBOL=XAU/USD
# OIL_SYMBOL=WTI/USD
